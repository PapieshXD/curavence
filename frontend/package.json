{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "node ../.github/scripts/frontend-lint.cjs",
    "lint:raw": "eslint src",
    "coverage": "ng test --watch=false --coverage --coverage-reporters=html --coverage-reporters=lcov --coverage-reporters=text-summary --runner-config=vitest.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@cornerstonejs/core": "^5.18.3",
    "@cornerstonejs/dicom-image-loader": "^5.18.3",
    "@cornerstonejs/tools": "^5.18.3",
    "dicom-parser": "^1.8.21",
    "events": "^3.3.0",
    "fs": "file:shims/fs",
    "path": "^0.12.7",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
  }
}
